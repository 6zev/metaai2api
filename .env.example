# Copy to .env and fill in. A .env in the working directory is read on start.
#
# Precedence: a variable already exported in the real environment WINS over this
# file, so a platform-injected secret is never silently replaced. To use a file
# elsewhere: META_DOT_ENV=/etc/metaai2api/.env
# To disable it entirely: META_DOT_ENV=

# --- session -----------------------------------------------------------------
# The full Cookie header from meta.ai. Used for GraphQL (conversation history,
# admin diagnostics). Long-lived; contains datr, ecto_1_sess, wd, dpr.
META_COOKIE="datr=...; ecto_1_sess=...; wd=441x850; dpr=2.45"

# The DGW access token, used for chat, images and video over the websocket.
#
# This is NOT derived from the cookie. Two sessions were compared: the cookie
# rotated while this value stayed identical, so it cannot be regenerated from
# the cookie. It is long-lived (survived more than a day here) but can be
# revoked, so treat it as a separate secret.
#
# Where to find it: the accessToken field embedded in the meta.ai page HTML, or
# the Authorization query parameter on the wss://gateway.meta.ai/ws request.
META_ACCESS_TOKEN="ecto1:..."

# --- HTTP surface ------------------------------------------------------------
# Bearer token for /v1. Empty means /v1 is open.
API_TOKEN=""

# Bearer token for /admin/*. Empty removes those routes entirely (404).
ADMIN_TOKEN=""

# --- backend -----------------------------------------------------------------
# mock (default) answers without contacting meta.ai.
# experimental-dgw needs META_ACCESS_TOKEN plus a recorded prompt template.
BACKEND=mock

# --- proxy -------------------------------------------------------------------
# http, https, socks5 or socks5h. Credentials in the URL are redacted in logs.
# ALL_PROXY / HTTP_PROXY are used when this is empty.
# ALL_PROXY="socks5://127.0.0.1:1080"

# --- optional ----------------------------------------------------------------
# Path to the YAML config, when it is not ./config.yaml.
# META_CONFIG=/etc/metaai2api/config.yaml
